// Recursos do Windows do anigo-studio.exe: ícone do arquivo (Explorer, atalho da área de trabalho, barra de tarefas fixada)
// e a aba "Detalhes" das propriedades.
#include <winver.h>

1 ICON "anigo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "ANIGO"
            VALUE "FileDescription", "ANIGO Studio"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "anigo-studio"
            VALUE "OriginalFilename", "anigo-studio.exe"
            VALUE "ProductName", "ANIGO Studio"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
